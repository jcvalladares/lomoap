[
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®. Answer concisely and only using the official user guide."}, {"role": "user", "content": "What are the default credentials for the System Administrator in EXAMPLE Express?"}, {"role": "assistant", "content": "Username: admin. Password: admin. Change the password after the first login."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®. Answer concisely and only using the official user guide."}, {"role": "user", "content": "How do I log in to EXAMPLE Express?"}, {"role": "assistant", "content": "Open a supported browser and go to http://localhost/[Express virtual directory]/default.aspx, then enter your username and password and click Login."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "How can I log out of EXAMPLE Express?"}, {"role": "assistant", "content": "Click Logout in the system navigation at the top of the screen."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "Can I use multiple browser windows or sessions with EXAMPLE Express?"}, {"role": "assistant", "content": "No. Multiple windows, tabs, or sessions are not supported and can cause data corruption."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "List the main actions I can perform when working with quotes and policies."}, {"role": "assistant", "content": "Start new quotes; search, view, duplicate, download, or delete quotes/policies; and create policy documents."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "How do I start a quote for a new client?"}, {"role": "assistant", "content": "Click New Quote in the upper-right. Agents/Assistants can select Agency, Producer, and Product on the dashboard under New Quote, then click Start."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "How do I start a quote for an existing client?"}, {"role": "assistant", "content": "Open the client's Client Information page and click Start A New Quote under Policies and Quotes."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "How do I duplicate a quote or policy?"}, {"role": "assistant", "content": "In any list of quotes/policies (search results or a Client Information page), click the Duplicate button to create a new quote with the same information."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "When searching, which operator takes precedence: AND or OR?"}, {"role": "assistant", "content": "AND takes precedence over OR."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "How can I list all quotes and policies?"}, {"role": "assistant", "content": "On the Search page, set “I’m looking for” to All Policies and Quotes, optionally set filters, then click Search."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "How do I view policy data versus policy details?"}, {"role": "assistant", "content": "To view data: use Recently Accessed, the View Policy button, or Policy Actions → View Policy. To view details/attachments: click View Policy Details or Policy Actions → View Policy Details."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "How do I create and attach a policy document?"}, {"role": "assistant", "content": "From an open policy, go to Policy Actions → Create Policy Documents and select a document. Save or print it. To attach it, save the file and upload it from the Attachments section on the Policy Details page."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "How do I download a policy or quote as XML?"}, {"role": "assistant", "content": "Click the Download button in a list, then Save in the File Download dialog, choose a location in Save As, and finish the download."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "How are new clients created?"}, {"role": "assistant", "content": "They are created automatically when you create a quote with a new client name. Or you can create one manually from Search → Create New Client."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "Where do I update client information?"}, {"role": "assistant", "content": "Open the Client Information page and click Update Client Details in the Client Details section."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "How can I create a task linked to a policy?"}, {"role": "assistant", "content": "From that policy’s Policy Details page, in the Tasks section click Add A Task, fill in the information, and click Create Task."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "What can managers do on the Task Management page?"}, {"role": "assistant", "content": "View all tasks within their queues, sort by queue/assignee/state/due date/category, and distribute or reassign tasks."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "How do I send a general notification to selected users?"}, {"role": "assistant", "content": "Go to Notifications → Send A Notification, choose Selected users/entities/groups, pick recipients, set Type and Subject, enter the message, then click Send."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "What happens when I delete a notification?"}, {"role": "assistant", "content": "It is deleted from the database and removed from all users’ notification lists."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "Where can I work with policy notes without leaving the screen I’m on?"}, {"role": "assistant", "content": "Use the Underwriter’s Workbench Toolbar at the bottom of the window to view, add, or delete notes."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "Who can mark notes as Internal Only?"}, {"role": "assistant", "content": "Users with Security Level CarrierAdmin or CarrierUser (Underwriter) at the entity associated with the policy."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "How do I open an item from a batch report?"}, {"role": "assistant", "content": "On Batch Policy, click the Client Name. On Batch Notification, click the Subject."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "How do I request a new EXAMPLE Express account?"}, {"role": "assistant", "content": "From the login page, click Get an Agency Account, complete the form, and submit. Your account is activated after an administrator approves it in EXAMPLE UserAdmin."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "How do I change my password in EXAMPLE Express?"}, {"role": "assistant", "content": "Click Change Password under Login Options (or at the bottom-left of the dashboard), enter your current password, set a new password, and click Change Password."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "How can I save my table column and sorting preferences?"}, {"role": "assistant", "content": "Adjust the table, then click Save Table Settings. To revert, click Restore Defaults."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "How do I sort a table and reverse the sort?"}, {"role": "assistant", "content": "Click a column header to sort ascending; click it again for descending. You can also use the header’s dropdown to choose Sort Ascending or Sort Descending."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "Where do I start address verification for an applicant?"}, {"role": "assistant", "content": "On the Applicant screen of a new quote, in the Geocoding Status area click Verify to send the address to Pitney Bowes."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "What information does the verification result include?"}, {"role": "assistant", "content": "Verified address, latitude/longitude, and a confidence percentage with a match code."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "What if address verification fails with an error?"}, {"role": "assistant", "content": "Confirm the configured username, password, and URL for Pitney Bowes Address Verification."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "Can I edit a verified address? What happens?"}, {"role": "assistant", "content": "Yes. Editing a verified address changes it in EXAMPLE but makes it unverified; re-verify if needed."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "How do I add an attachment from the Underwriter’s Workbench Toolbar?"}, {"role": "assistant", "content": "Click Attachments → Add an Attachment, Browse to the file, then Add Attachment. You need the AddAttachments security level."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®."}, {"role": "user", "content": "Why is the Add Attachment button disabled?"}, {"role": "assistant", "content": "It remains disabled until all required fields for the attachment are completed."}]}
{"messages": [{"role": "system", "content": "You are a precise helpdesk assistant for EXAMPLE Express®. Avoid speculation."}, {"role": "user", "content": "Who can delete notes or attachments?"}, {"role": "assistant", "content": "Deleting notes requires CarrierAdmin level. Deleting attachments requires the DeleteAttachments security level."}]}
]